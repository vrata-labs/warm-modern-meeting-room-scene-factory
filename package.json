{
  "name": "@vrata/warm-modern-meeting-room-scene-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile:shell": "node compiler/compile-room-shell.mjs",
    "compile:candidate-architecture": "node compiler/compile-room-shell.mjs --input-kind approved-candidate-architecture",
    "compile:candidate-components": "node compiler/compile-room-shell.mjs --input-kind approved-candidate-components",
    "compile:candidate-media-surfaces": "node compiler/compile-room-shell.mjs --input-kind approved-candidate-media-surfaces",
    "compile:candidate-exterior": "node compiler/compile-room-shell.mjs --input-kind approved-candidate-exterior",
    "verify:reproducibility": "node compiler/verify-room-reproducibility.mjs",
    "verify:candidate-architecture": "node compiler/verify-room-reproducibility.mjs --input-kind approved-candidate-architecture",
    "verify:candidate-components": "node compiler/verify-room-reproducibility.mjs --input-kind approved-candidate-components",
    "verify:candidate-media-surfaces": "node compiler/verify-room-reproducibility.mjs --input-kind approved-candidate-media-surfaces",
    "verify:candidate-exterior": "node compiler/verify-room-reproducibility.mjs --input-kind approved-candidate-exterior",
    "validate": "node scripts/validate-experiment.mjs && node scripts/check-repository-boundary.mjs",
    "verify:runtime-gates": "python3 scripts/verify-runtime-wheel-lock.py --lock-only && python3 scripts/verify-patched-pytorch-lock.py && python3 scripts/verify-offline-runtime-lock.py",
    "test": "node --test tests/*.test.mjs",
    "test:candidate-architecture": "node --test tests/approved-candidate-architecture.test.mjs",
    "test:candidate-components": "node --test tests/approved-candidate-components.test.mjs",
    "test:candidate-media-surfaces": "node --test tests/approved-candidate-media-surfaces.test.mjs",
    "test:candidate-exterior": "node --test tests/approved-candidate-exterior.test.mjs",
    "test:exterior-contract": "node --test tests/exterior-construction-contract.test.mjs",
    "test:lighting-contract": "node --test tests/lighting-construction-contract.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "gltf-validator": "2.0.0-dev.3.10"
  }
}
